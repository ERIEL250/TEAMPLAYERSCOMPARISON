{
  "name": "football-team-comparison",
  "version": "1.0.0",
  "description": "Football team comparison app using football-data.org v4 API",
  "main": "server/index.js",
  "scripts": {
    "install-all": "cd server && npm install && cd ../client && npm install && npm install",
    "server": "cd server && npm run dev",
    "proxy": "node proxy-server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run proxy\" \"npm run client\"",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2"
  },
  "keywords": ["football", "comparison", "football-data.org"],
  "author": "",
  "license": "MIT"
}