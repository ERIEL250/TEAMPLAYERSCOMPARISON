# football-data.org API key - get your free key at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=your_api_key_here

# Server port
PORT=5000

# Client API URL
REACT_APP_API_URL=http://localhost:5000/api

# Image Provider Configuration
# The app uses a separate image-provider abstraction that supports multiple licensed image sources:
# 1. TheSportsDB (default enabled - free tier, non-commercial use with attribution)
# 2. API-Football (requires API key, paid tiers for commercial use)
# 3. Local self-hosted images (enable for production use)

# API-Football configuration (optional)
# REACT_APP_API_FOOTBALL_KEY=your-api-football-key-here

# Image source selection (set only one to true)
# REACT_APP_IMAGE_SOURCE=thesportsdb (default)
# REACT_APP_IMAGE_SOURCE=apifootball
# REACT_APP_IMAGE_SOURCE=local

# Image attribution is required for all third-party sources. See client/src/utils/imageProvider.js for details.
# Local mappings for players/teams/competitions can be added in client/src/utils/imageProvider.js's LOCAL_MAPPINGS object.